{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pistachio-talk/schema/lead.schema.json",
  "title": "Lead (scouted rumor)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "date",
    "scouted_by",
    "language",
    "country_region",
    "map_anchor",
    "teaser_ja",
    "candidate",
    "status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^lead-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "date": { "type": "string", "format": "date" },
    "scouted_by": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{2,3}$" },
    "country_region": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "minItems": 1
    },
    "map_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "teaser_ja": { "type": "string", "minLength": 1 },
    "intrigue_tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "uniqueItems": true
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phrase_original", "gloss_hint", "sources"],
      "properties": {
        "phrase_original": { "type": "string", "minLength": 1 },
        "gloss_hint": { "type": "string", "minLength": 1 },
        "kiza_elements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["metaphor", "wit", "poetic_image", "cultural_allusion"]
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["fresh", "open", "collected", "rejected"]
    },
    "picked_for": { "type": ["string", "null"], "format": "date" },
    "resolution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "phrase_id": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
